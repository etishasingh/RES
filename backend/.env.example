# PayPilot AI Backend Environment Variables
# Copy this file to backend/.env and replace the placeholder values with your own.

# Long random string used to sign JWT session cookies
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
SESSION_SECRET=change-me-use-a-long-random-string

# Password assigned to demo accounts created by backend/seed.py
DEMO_PASSWORD=change-me

# PayPal Sandbox REST API Credentials
# Go to https://developer.paypal.com -> Dashboard -> Apps & Credentials -> Sandbox -> Create App (Merchant)
# Tip: Select a US Sandbox Business account for USD milestone payments.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
