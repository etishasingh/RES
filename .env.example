# ==============================================================================
# PayPilot AI – Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / Render Static Site)
# ------------------------------------------------------------------------------
# In local development: leave blank or unset to use the Vite local proxy (port 8000)
# In production on Render: set to your deployed backend URL:
# VITE_API_BASE_URL=https://paypilotai-xa4x.onrender.com
VITE_API_BASE_URL=https://paypilotai-xa4x.onrender.com

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI / Render Web Service)
# ------------------------------------------------------------------------------
# Mandatory random string used to sign JWT session cookies and Bearer tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
SESSION_SECRET=dev-paypilot-super-secret-key-change-in-prod-12345

# Set to "production" in Render environment to enable secure cookies (SameSite=None; Secure=True)
ENVIRONMENT=production

# Frontend URL(s) for CORS allowed origins (comma-separated if multiple)
FRONTEND_URL=https://paypilot-frontend.onrender.com
CORS_ORIGINS=https://.*\.onrender\.com,http://localhost:3000,http://localhost:3001

# Password assigned to seeded demo accounts
DEMO_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Optional: Render PostgreSQL connection string (defaults to local pre-seeded SQLite db if unset)
# DATABASE_URL=postgresql://user:password@host/dbname
# Optional: Custom path for SQLite persistent disk (e.g., /var/data/paypilot.db)
# SQLITE_DB_PATH=backend/paypilot.db

# ------------------------------------------------------------------------------
# PAYPAL SANDBOX REST API CREDENTIALS
# ------------------------------------------------------------------------------
# Obtain from https://developer.paypal.com -> Dashboard -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox
