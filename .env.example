# ==============================================================================
# PayPilot AI – Environment Configuration Template (Unified Single Web Service)
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE BACKEND & AUTH CONFIGURATION (Render Web Service)
# ------------------------------------------------------------------------------
# Mandatory random string used to sign JWT session cookies and Bearer tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(48))"
SESSION_SECRET=dev-paypilot-super-secret-key-change-in-prod-12345

# Set to "production" in Render environment to enable secure cookies
ENVIRONMENT=production

# Password assigned to seeded demo accounts
DEMO_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# FRONTEND API CONFIGURATION
# ------------------------------------------------------------------------------
# In unified single-service deployment on Render: LEAVE BLANK / UNSET.
# The React SPA is served directly by FastAPI from the same origin, so all
# API requests use relative paths (/api/...) without CORS or domain mismatches.
# Only set this if you explicitly point to an external API service.
# VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# CORS CONFIGURATION (Optional for single-service, useful for local dev)
# ------------------------------------------------------------------------------
# FRONTEND_URL=https://your-custom-domain.com
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default: Uses the pre-seeded SQLite database backend/paypilot.db
# Optional Render PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host/dbname
# Optional custom path for Render persistent disk:
# SQLITE_DB_PATH=backend/paypilot.db

# ------------------------------------------------------------------------------
# PAYPAL SANDBOX REST API CREDENTIALS
# ------------------------------------------------------------------------------
# Obtain from https://developer.paypal.com -> Dashboard -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox
